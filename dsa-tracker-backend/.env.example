# ─── Copy this to .env and fill in your values ────────────────────────────────
# Never commit .env to Git

# Local PostgreSQL
DATABASE_URL=jdbc:postgresql://localhost:5432/dsa_tracker
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=yourpassword

# JWT — use a long random string in production
JWT_SECRET=your-super-secret-jwt-key-at-least-256-bits-long-change-this
JWT_EXPIRATION_MS=86400000

# CORS — comma separated, no trailing slash
# Local frontend dev server
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Production (set these in Railway dashboard, not here) ────────────────────
# DATABASE_URL=          (Railway provides this automatically as a reference var)
# JWT_SECRET=            (set a strong random value)
# CORS_ALLOWED_ORIGINS=  (your Vercel URL e.g. https://dsa-tracker.vercel.app)
